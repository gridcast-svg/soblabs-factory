FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
WORKDIR /app
COPY --chown=node:node . .
ENV DATABASE_URL=postgresql://postgres@127.0.0.1:5432/build_only
ENV CRM_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1
RUN --mount=type=secret,id=cloud-ca set -eu; \
    if [ -f /run/secrets/cloud-ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/cloud-ca SSL_CERT_FILE=/run/secrets/cloud-ca; fi; \
    export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}"; \
    apt-get update; \
    apt-get install -y --no-install-recommends openssl ca-certificates; \
    npm install -g bun@1.3.12 --no-audit --no-fund; \
    bun install --frozen-lockfile; \
    bun run db:generate; \
    bunx turbo run build --filter=api; \
    rm -rf /root/.bun/install/cache /root/.npm /var/lib/apt/lists/*
ENV NODE_ENV=production
EXPOSE 10000
USER node
CMD ["sh", "-c", "cd /app/packages/db && bun run prisma migrate deploy && cd /app/apps/api && exec bun run start:prod"]
